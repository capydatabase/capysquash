# Docker environment for the compose files. Copy to .env and adjust.
# Only variables the compose files actually read are listed here.

# Image build metadata (compose.yaml)
BUILD_VERSION=dev
BUILD_DATE=unknown
GIT_COMMIT=unknown

# capysquash (all compose files)
CAPYSQUASH_LOG_LEVEL=info

# Validation databases (compose.yaml, compose.testing.yaml)
POSTGRES_PASSWORD=capysquash_secure_password_change_me
POSTGRES_PRIMARY_PORT=5432
POSTGRES_17_PORT=5417
POSTGRES_16_PORT=5416
POSTGRES_15_PORT=5415

# Optional tools (compose.tools.yaml, --profile tools)
# pgAdmin rejects reserved domains (.localhost/.local), so keep a real-looking address.
PGADMIN_EMAIL=admin@capysquash.dev
PGADMIN_PASSWORD=capysquash_pgadmin_change_me
PGADMIN_PORT=5050
FILEBROWSER_PORT=8081

# Bind-mount sources (docker/validation/with-validation.yml)
MIGRATIONS_DIR=./migrations
OUTPUT_DIR=./output
CONFIG_DIR=./config
