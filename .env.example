# pgsquash Docker Environment Configuration
# Copy this file to .env and customize the values

# ========================================
# Build Configuration
# ========================================
BUILD_VERSION=dev
DOCKER_REGISTRY=
DOCKER_REPOSITORY=pgsquash
DOCKER_PlatformS=linux/amd64,linux/arm64

# ========================================
# pgsquash Application Configuration
# ========================================

# Safety and behavior
PGSQUASH_SAFETY_LEVEL=standard
PGSQUASH_AUTO_VALIDATE=true
PGSQUASH_DOCKER_ENABLED=true
PGSQUASH_INIT_SAMPLE=false
PGSQUASH_AUTO_SETUP=true

# Logging
PGSQUASH_LOG_LEVEL=info
PGSQUASH_LOG_FORMAT=json

# ========================================
# PostgreSQL Configuration
# ========================================

# Primary PostgreSQL (17)
POSTGRES_PASSWORD=pgsquash_secure_password_change_me
POSTGRES_PRIMARY_PORT=5432

# Secondary PostgreSQL (15) - for multi-version testing
POSTGRES_SECONDARY_PORT=5433

# Legacy PostgreSQL (14) - for legacy testing
POSTGRES_LEGACY_PORT=5434

# ========================================
# Redis Configuration
# ========================================
REDIS_PASSWORD=pgsquash_redis_change_me
REDIS_PORT=6379

# ========================================
# MinIO Configuration (S3-compatible storage)
# ========================================
MINIO_ROOT_USER=pgsquash
MINIO_ROOT_PASSWORD=pgsquash_minio_password_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========================================
# Monitoring Configuration
# ========================================

# Grafana
GRAFANA_PASSWORD=pgsquash_grafana_change_me
GRAFANA_PORT=3000

# Prometheus
PROMETHEUS_PORT=9090

# ========================================
# Management Tools Configuration
# ========================================

# pgAdmin
PGADMIN_EMAIL=admin@pgsquash.localhost
PGADMIN_PASSWORD=pgsquash_pgadmin_change_me
PGADMIN_PORT=5050

# File Browser
FILEBROWSER_PORT=8081

# ========================================
# Proxy and SSL Configuration
# ========================================

# Traefik
TRAEFIK_DASHBOARD_PORT=8080
ACME_EMAIL=admin@localhost

# ========================================
# Development Settings
# ========================================

# Enable development profiles
COMPOSE_PROFILES=multi-version,monitoring,management

# Docker Compose project name
COMPOSE_PROJECT_NAME=pgsquash

# ========================================
# GitHub Integration (API Server)
# ========================================

# GitHub App/OAuth Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/github/callback

# GitHub App Configuration (for multi-repository support)
# App: CapySquash (ID: 2146919)
GITHUB_APP_ID=2146919
GITHUB_APP_WEBHOOK_SECRET=f63cae21e178d825079858c45c7ca5d030f58e48061607fc3394d20f022b938e
GITHUB_CLIENT_ID=Iv23li6L3X7maKxDJLUk
GITHUB_CLIENT_SECRET=48f96a6506331a7942878f6f78f3def6ca17f8d2
# For Fly.io deployment: use [[files]] mounting with GITHUB_APP_PRIVATE_KEY_BASE64
# GITHUB_APP_PRIVATE_KEY_PATH=/app/github-app-key.pem
# GITHUB_APP_PRIVATE_KEY_BASE64=<base64-encoded-private-key>
# For local development: use GITHUB_APP_PRIVATE_KEY with multiline PEM content
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# API Server
API_SERVER_PORT=8080
API_SERVER_CORS_ORIGIN=*

# ========================================
# CI/CD Configuration
# ========================================

# GitHub Container Registry
GITHUB_REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-username/pgsquash

# Docker Hub
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token

# ========================================
# Advanced Configuration
# ========================================

# Memory limits (in MB)
POSTGRES_MEMORY_LIMIT=512
REDIS_MEMORY_LIMIT=256
PGSQUASH_MEMORY_LIMIT=1024

# Resource limits
POSTGRES_CPU_LIMIT=1.0
REDIS_CPU_LIMIT=0.5
PGSQUASH_CPU_LIMIT=2.0

# Networking
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Backup and restore
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# Health check intervals
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ========================================
# AI Provider Configuration
# ========================================

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI (v1 API)
# Default provider for CapySquash (Anthropic as fallback, OpenAI as last resort)
AZURE_OPENAI_ENDPOINT=https://myroomieai-eu.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=33pLo7ZHfJfIaye5WF0ivQT39TwJgK7zYTrjUrYT96N3yMvfZnXkJQQJ99BAACfhMk5XJ3w3AAABACOGsG6J
# Optional: Azure API version (defaults to "preview" for v1 API)
# Use "preview" for v1 API (recommended - latest features, no monthly version updates)
# Or use specific version like "2024-10-21" for legacy API with api-version parameter
# AZURE_OPENAI_API_VERSION=preview
# Optional: Use Azure AD authentication instead of API key
# Set to true to use DefaultAzureCredential
# AZURE_OPENAI_USE_AD=false