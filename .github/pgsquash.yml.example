# pgsquash Repository Configuration
# Copy this file to .github/pgsquash.yml in your repository

# Automatically analyze migrations on PR events (opened, synchronize)
auto_analyze: true

# Automatically create consolidation PRs when threshold is met
auto_pr: false

# Minimum number of migration files to trigger auto-consolidation
migration_threshold: 15

# Safety level for consolidation
# Options: paranoid, conservative, standard, aggressive
safety_level: standard

# Analysis settings
analysis:
    # Enable AI-powered semantic analysis (requires API key)
    enable_ai: false

    # Show detailed cycle detection information
    show_cycle_details: true

    # Maximum cycle detection depth
    cycle_depth: 10

# Consolidation settings
consolidation:
    # Output directory for consolidated migrations
    output_dir: migrations/consolidated

    # File naming pattern
    # Available variables: {timestamp}, {count}, {type}
    file_pattern: "{timestamp}_consolidated_{type}.sql"

    # Group migrations by type
    group_by_type: true

    # Include rollback scripts
    include_rollback: true

# Validation settings
validation:
    # Enable Docker validation
    enable_docker: true

    # Docker validation approach
    # Options: TWO_CONTAINERS, TWO_DATABASES, SCHEMA_DIFF
    docker_approach: TWO_DATABASES

    # Enable automatic SQL fixes
    auto_fix_sql: false

    # Detect and install PostgreSQL extensions
    detect_extensions: true

# Comment settings
comments:
    # Post analysis results as PR comment
    post_analysis: true

    # Include redundancy details in comments
    show_redundancies: true

    # Show optimization suggestions
    show_suggestions: true

    # Maximum redundancies to display (rest collapsed)
    max_redundancies_shown: 5

# Performance settings
performance:
    # Enable streaming mode for large migration sets
    enable_streaming: true

    # Batch size for streaming processing
    batch_size: 50

    # Memory limit in MB
    memory_limit_mb: 256

# Workflow triggers
triggers:
    # Paths to watch for migration files
    watch_paths:
        - "migrations/**/*.sql"
        - "db/migrations/**/*.sql"
        - "supabase/migrations/**/*.sql"

    # Ignore patterns
    ignore_paths:
        - "migrations/archive/**"
        - "**/*.bak.sql"

    # Required PR labels before auto-consolidation
    required_labels:
        - "ready-to-consolidate"

    # Block auto-consolidation if these labels present
    blocking_labels:
        - "do-not-consolidate"
        - "wip"

# Team settings
team:
    # Require approval before consolidation
    require_approval: false

    # Reviewers to auto-assign on consolidation PRs
    auto_assign_reviewers:
        - "database-team"

    # Notify on Slack/Discord (requires webhook setup)
    notify_on_consolidation: false
    notification_webhook: ""

# Feature flags
features:
    # Enable transformation and modernization
    enable_transformations: true

    # Enable backup generation
    enable_backups: false

    # Enable advanced DDL cycle detection
    enable_cycle_detection: true

    # Enable function deduplication
    enable_function_dedup: true

    # Enable dead code detection
    enable_dead_code_detection: true
