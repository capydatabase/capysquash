# pgsquash Environment Configuration Template
# Copy this file to .env and customize for your environment

# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# Safety level for migration squashing
# Options: conservative, standard, aggressive, paranoid
PGSQUASH_SAFETY_LEVEL=standard

# Enable automatic validation after squashing
PGSQUASH_AUTO_VALIDATE=true

# Enable Docker-based validation features
PGSQUASH_DOCKER_ENABLED=true

# Initialize with sample migration data
PGSQUASH_INIT_SAMPLE=false

# Logging level
# Options: debug, info, warning, error
PGSQUASH_LOG_LEVEL=info

# ============================================================================
# DIRECTORY PATHS
# ============================================================================

PGSQUASH_HOME=/app
PGSQUASH_MIGRATIONS_DIR=/app/migrations
PGSQUASH_OUTPUT_DIR=/app/output
PGSQUASH_LOGS_DIR=/app/logs
PGSQUASH_CONFIG=/app/config/pgsquash.config.json

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Primary Database
POSTGRES_DB=pgsquash_primary
POSTGRES_USER=pgsquash
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PRIMARY_PORT=5432

# PostgreSQL Secondary Database (for multi-version testing)
POSTGRES_SECONDARY_PORT=5433
POSTGRES_LEGACY_PORT=5434

# ============================================================================
# REDIS CONFIGURATION (Optional)
# ============================================================================

REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ============================================================================
# MINIO CONFIGURATION (Optional)
# ============================================================================

MINIO_ROOT_USER=pgsquash
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================================
# MONITORING (Optional)
# ============================================================================

GRAFANA_PASSWORD=your_grafana_password_here
GRAFANA_PORT=3000

PROMETHEUS_PORT=9090

# ============================================================================
# MANAGEMENT TOOLS (Optional)
# ============================================================================

PGADMIN_EMAIL=admin@pgsquash.local
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

FILEBROWSER_PORT=8081

# ============================================================================
# TRAEFIK (Optional)
# ============================================================================

TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Let's Encrypt Email for SSL certificates
LETSENCRYPT_EMAIL=your_email@example.com

# ============================================================================
# DOCKER COMPOSE PROFILES
# ============================================================================

# Comma-separated list of profiles to enable
# Options: multi-version, legacy, caching, storage, monitoring, management, proxy
# Example: COMPOSE_PROFILES=monitoring,management
COMPOSE_PROFILES=

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

BUILD_VERSION=dev
