{
  "safety_level": "${PGSQUASH_SAFETY_LEVEL}",
  "output": {
    "directory": "${PGSQUASH_OUTPUT_DIR}",
    "format": "sql",
    "group_by": "semantic",
    "add_comments": true,
    "preserve_formatting": false,
    "file_naming": {
      "pattern": "{sequence}_{category}.sql",
      "zero_pad": 3
    }
  },
  "rules": {
    "enable_external_dependency_filter": true,
    "enable_column_evolution": true,
    "enable_rls_consolidation": true,
    "enable_function_deduplication": true,
    "enable_dead_code_removal": false,
    "consolidation_rules": {
      "conservative": [
        "MultipleCreateConsolidationRule",
        "CreateAlterConsolidationRule"
      ],
      "standard": [
        "MultipleCreateConsolidationRule",
        "CreateAlterConsolidationRule",
        "DropCreateCycleRule"
      ],
      "aggressive": [
        "MultipleCreateConsolidationRule",
        "CreateAlterConsolidationRule",
        "DropCreateCycleRule",
        "FunctionDeduplicationRule"
      ]
    }
  },
  "validation": {
    "enabled": ${PGSQUASH_AUTO_VALIDATE},
    "docker_enabled": ${PGSQUASH_DOCKER_ENABLED},
    "postgresql_versions": ["17", "16", "15", "18"],
    "validation_approach": "two_databases",
    "timeout_minutes": 10,
    "parallel_validation": true,
    "container_ready_timeout_seconds": 30,
    "max_port_search_attempts": 1000
  },
  "performance": {
    "enable_streaming": true,
    "streaming_threshold": 100,
    "batch_size": 50,
    "memory_limit_mb": 512,
    "progress_reporting": true,
    "worker_count": 4
  },
  "modern_features": {
    "enable_advanced_types": true,
    "enable_partitioning": true,
    "enable_json_operations": true,
    "postgresql_version": "17"
  },
  "ai": {
    "enabled": false,
    "provider": "auto",
    "max_retries": 3,
    "timeout_seconds": 60,
    "enable_semantic_analysis": false,
    "enable_dead_code_detection": false,
    "enable_auth_pattern_detection": true,
    "enable_post_processing_validation": false,
    "enable_auto_repair": false,
    "confidence_threshold": 0.85
  },
  "logging": {
    "level": "${PGSQUASH_LOG_LEVEL}",
    "format": "text",
    "output": "stdout"
  }
}
